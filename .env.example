# ProtonVPN OpenVPN credentials
# Get these from: https://account.protonvpn.com → Account → OpenVPN / IKEv2 credentials
# NOT your Proton login credentials!
# Add +pmp to the end of the username for port forwarding (Plus/Unlimited plans only)

OPENVPN_USER=your_openvpn_username+pmp
OPENVPN_PASSWORD=your_openvpn_password
