# ProtonVPN WireGuard credentials
# Get these from: https://account.protonvpn.com → Downloads → WireGuard configuration
# Select: Linux, NAT-PMP (Port Forwarding) enabled, Standard server (not Secure Core)

WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_PUBLIC_KEY=your_wireguard_public_key_here

# Pi-hole admin password
PIHOLE_PASSWORD=your_pihole_password_here

# Cloudflare Tunnel token
# Get from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
